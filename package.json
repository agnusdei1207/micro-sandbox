{
  "name": "@agnusdei12071207/micro-sandbox",
  "version": "0.0.1",
  "description": "Fail-closed Linux sandbox for running untrusted commands from Node.js",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE",
    "docs/ARCHITECTURE.md",
    "docs/ARCHITECTURE.ko.md"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.spec.ts",
    "test:native": "node scripts/native.mjs test",
    "test:kernel": "node scripts/native.mjs kernel",
    "test:integration": "npm run build && node scripts/native.mjs integration",
    "build:native": "node scripts/build-native.mjs",
    "build:native:docker": "node scripts/build-platforms.mjs",
    "package:verify": "node scripts/verify-package.mjs",
    "package:smoke": "node scripts/pack-smoke.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "release:publish-local": "node scripts/publish-local.mjs",
    "check": "npm run test && npm run test:native && npm audit --audit-level=moderate",
    "prepack": "npm run clean && npm run build && node scripts/verify-package.mjs --source-only"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "optionalDependencies": {
    "micro-sandbox-linux-arm64": "0.0.1",
    "micro-sandbox-linux-x64": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agnusdei1207/micro-sandbox.git"
  },
  "homepage": "https://github.com/agnusdei1207/micro-sandbox#readme",
  "bugs": {
    "url": "https://github.com/agnusdei1207/micro-sandbox/issues"
  },
  "keywords": [
    "sandbox",
    "linux-sandbox",
    "untrusted-code",
    "process-isolation",
    "linux-namespaces",
    "cgroup-v2",
    "seccomp",
    "container-security",
    "nodejs",
    "rust"
  ],
  "author": "agnusdei1207",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
